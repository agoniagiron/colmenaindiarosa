VITE_API_URL=http://localhost:3001
# Llave PÚBLICA de Wompi (debe coincidir con WOMPI_LLAVE_PUBLICA en api/.env).
# La privada y los secretos nunca van acá.
VITE_WOMPI_LLAVE_PUBLICA="pub_test_..."

# Ruta de acceso administrativo. Cambiar el valor en producción — no se
# enlaza desde ningún lugar del sitio público, y quien no la conoce no
# tiene forma de encontrarla navegando.
VITE_RUTA_ADMIN=/acceso-interno

# --- Supabase Storage (subida de imágenes desde el panel admin) --------
# Mismo proyecto que SUPABASE_URL en api/.env.
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
# Llave ANÓNIMA/pública (Settings → API → anon public). Segura de exponer:
# sin una URL firmada emitida por api/ no puede escribir en el bucket. La
# service_role NUNCA va acá.
VITE_SUPABASE_ANON_KEY="reemplazar-con-la-anon-key-del-proyecto"
