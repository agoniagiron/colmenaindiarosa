# Puerto del servidor Express.
PORT=3001

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Cadena de conexión de la aplicación (pooler de Supabase en modo
# transacción, puerto 6543, con pgbouncer=true). Es la que usa Prisma
# Client en runtime.
DATABASE_URL="postgresql://usuario:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena de conexión directa (pooler de Supabase en modo sesión, puerto
# 5432, sin pgbouncer). La usa Prisma para introspección (`prisma db pull`)
# y migraciones.
DIRECT_URL="postgresql://usuario:password@host.pooler.supabase.com:5432/postgres?connect_timeout=10"

# Base de PostgreSQL LOCAL y descartable, solo para las pruebas de
# integración reales bajo src/__tests__/integracion/ (nunca Supabase). Se
# crea o se recrea con: npx tsx scripts/preparar-db-prueba.ts (requiere
# psql y pg_dump en el PATH). Si no está configurada, esas pruebas se
# saltan en vez de fallar.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/india_rosa_test"

# Secreto para firmar los access tokens (JWT). Generar uno propio por
# entorno, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="reemplazar-con-un-valor-aleatorio-largo"

# Secreto propio de los access tokens del panel de administración (módulo
# authAdmin/). Nunca el mismo valor que JWT_SECRET: un token de cliente no
# debe verificar contra este secreto, ni un token de admin contra el otro.
JWT_SECRET_ADMIN="reemplazar-con-otro-valor-aleatorio-largo-y-distinto"

# Número de WhatsApp de la tienda (código de país + número, sin +). El
# servidor lo usa para "notificar" (en dev, por consola) cuando un pedido
# queda pagado. Nunca se escribe en el código ni se expone al frontend.
NUMERO_WHATSAPP="573000000000"

# Origen exacto del frontend, usado por CORS (nunca un comodín: las
# cookies de sesión viajan con credentials). En desarrollo es el puerto de
# Vite; en producción, el dominio real donde queda publicado web/.
ORIGEN_WEB="http://localhost:5173"

# --- Wompi -------------------------------------------------------------
# Credenciales del comercio en Wompi (sandbox: comercios.wompi.co). La
# llave pública también va en web/.env como VITE_WOMPI_LLAVE_PUBLICA; la
# privada y los dos secretos NUNCA salen de api/.
WOMPI_ENTORNO=sandbox
WOMPI_LLAVE_PUBLICA="pub_test_..."
WOMPI_LLAVE_PRIVADA="prv_test_..."
WOMPI_SECRETO_INTEGRIDAD="reemplazar-con-el-secreto-de-integridad-del-comercio"
WOMPI_SECRETO_EVENTOS="reemplazar-con-el-secreto-de-eventos-del-comercio"
# A dónde redirige Wompi después del pago (pantalla de resultado del frontend).
WOMPI_URL_REDIRECCION="http://localhost:5173/pedido/resultado"

# --- Supabase Storage (imágenes de producto) ----------------------------
# URL del proyecto de Supabase (Settings → API → Project URL). El bucket
# 'productos' ya existe y es público; esto es solo para armar las URLs
# firmadas de subida.
SUPABASE_URL="https://tu-proyecto.supabase.co"
# Llave de servicio (Settings → API → service_role). NUNCA en web/.env: es
# la que permite firmar subidas y borrar archivos saltándose RLS.
SUPABASE_SERVICE_ROLE_KEY="reemplazar-con-la-service-role-key-del-proyecto"

# --- Seed (prisma/seed.ts) ----------------------------------------------
# Contraseñas de los usuarios de prueba que crea el seed. Sin valor por
# defecto a propósito: si faltan, el seed falla en vez de crear cuentas
# con una contraseña conocida hardcodeada en el repo.
SEED_CLIENTE_CLAVE=
SEED_ADMIN_CLAVE=
