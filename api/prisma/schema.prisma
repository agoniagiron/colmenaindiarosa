generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Atributo {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String          @unique
  slug            String          @unique
  orden           Int             @default(0)
  valoresAtributo ValorAtributo[]

  @@map("atributo")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BusquedaRegistro {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  termino      String
  resultados   Int           @default(0)
  sesionId     String?       @map("sesion_id") @db.Uuid
  creadoEn     DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  sesionVisita SesionVisita? @relation(fields: [sesionId], references: [id], onUpdate: NoAction)

  @@index([creadoEn], map: "idx_busqueda_creado")
  @@index([termino], map: "idx_busqueda_termino")
  @@map("busqueda_registro")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Carrito {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String?       @map("usuario_id") @db.Uuid
  visitanteId   String?       @map("visitante_id")
  cuponId       String?       @map("cupon_id") @db.Uuid
  convertidoEn  DateTime?     @map("convertido_en") @db.Timestamptz(6)
  pedidoId      String?       @unique @map("pedido_id") @db.Uuid
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime      @default(now()) @map("actualizado_en") @db.Timestamptz(6)
  cupon         Cupon?        @relation(fields: [cuponId], references: [id], onUpdate: NoAction)
  pedido        Pedido?       @relation(fields: [pedidoId], references: [id], onUpdate: NoAction)
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items         CarritoItem[]

  @@index([convertidoEn], map: "idx_carrito_convertido")
  @@index([visitanteId], map: "idx_carrito_visitante")
  @@map("carrito")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CarritoItem {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  carritoId        String            @map("carrito_id") @db.Uuid
  varianteId       String?           @map("variante_id") @db.Uuid
  cantidad         Int
  agregadoEn       DateTime          @default(now()) @map("agregado_en") @db.Timestamptz(6)
  comboId          String?           @map("combo_id") @db.Uuid
  carrito          Carrito           @relation(fields: [carritoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  combo            Combo?            @relation(fields: [comboId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  varianteProducto VarianteProducto? @relation(fields: [varianteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Sin @@unique acá a propósito: la base ya no lo tiene (una fila es
  // variante XOR combo, ver el check constraint). La idempotencia de
  // "ya está esta variante/combo en el carrito" pasa a resolverse en
  // modulos/carrito/servicio.ts (buscar antes de crear), no en la base.
  @@map("carrito_item")
}

